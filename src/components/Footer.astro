---
import { course, href } from '@/lib/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line bg-paper-2/60">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl text-ink">{course.title} <span class="font-mono text-sm text-ink-3">{course.code}</span></p>
      <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-2">
        {course.university}, {course.faculty}, {course.department}. {course.program}.
      </p>
      <p class="mt-4 font-mono text-xs text-ink-3">{course.meeting.day} {course.meeting.time} · {course.meeting.room}</p>
    </div>
    <nav aria-label="Footer" class="text-sm">
      <p class="eyebrow mb-3">Course</p>
      <ul class="space-y-2">
        <li><a class="link" href={href('/syllabus')}>Syllabus</a></li>
        <li><a class="link" href={href('/schedule')}>Schedule</a></li>
        <li><a class="link" href={href('/labs')}>Labs</a></li>
        <li><a class="link" href={href('/project')}>Semester project</a></li>
        <li><a class="link" href={href('/announcements')}>Announcements</a></li>
        <li><a class="link" href={course.previousSite.url} target="_blank" rel="noopener">Previous course site (2025)</a></li>
      </ul>
    </nav>
    <div class="text-sm">
      <p class="eyebrow mb-3">Contact</p>
      <p class="font-medium text-ink">{course.instructor.name}</p>
      <p><a class="link" href={`mailto:${course.instructor.email}`}>{course.instructor.email}</a></p>
      <ul class="mt-3 space-y-1.5">
        {course.channels.map((c) => <li><a class="link" href={c.url} target="_blank" rel="noopener">{c.name}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="wrap flex flex-col gap-2 py-5 font-mono text-[11px] text-ink-3 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {course.instructor.name}. Course materials for educational use.</p>
      <p>Static site. No tracking, no cookies.</p>
    </div>
  </div>
</footer>
