---
/** A copyable terminal block for lab instructions. Usage: <Terminal cmd="gh student submit" /> or with lines. */
interface Props { cmd?: string; lines?: string[]; out?: string; title?: string; }
const { cmd, lines = [], out, title = 'terminal' } = Astro.props;
const all = cmd ? [cmd, ...lines] : lines;
const text = all.join('\n');
---
<div class="terminal my-5 overflow-hidden rounded-xl border border-line-2 bg-card shadow-soft">
  <div class="flex items-center justify-between border-b border-line bg-paper-2 px-4 py-2">
    <span class="font-mono text-[11px] font-medium text-ink-3">&gt;_ {title}</span>
    <button type="button" data-copy={text} class="copy-btn rounded-md border border-line-2 bg-card px-2 py-0.5 font-mono text-[11px] text-ink-2 hover:border-ink hover:text-ink">copy</button>
  </div>
  <pre class="overflow-x-auto px-4 py-3 font-mono text-[13.5px] leading-relaxed text-ink"><code>{all.map((l) => (<span class="block font-medium"><span class="select-none text-accent">$ </span>{l}</span>))}{out && <span class="mt-1 block whitespace-pre-wrap text-ink-2">{out}</span>}</code></pre>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((b) => {
    if (b.dataset.bound) return;
    b.dataset.bound = '1';
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = 'copied ✓'; }
      catch { b.textContent = 'select & copy'; }
      setTimeout(() => (b.textContent = 'copy'), 1600);
    });
  });
</script>
