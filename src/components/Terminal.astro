---
/** A copyable terminal block for lab instructions. Usage: <Terminal cmd="gh student submit" /> or with lines. */
interface Props { cmd?: string; lines?: string[]; out?: string; title?: string; }
const { cmd, lines = [], out, title = 'terminal' } = Astro.props;
const all = cmd ? [cmd, ...lines] : lines;
const text = all.join('\n');
---
<div class="not-prose my-5 overflow-hidden rounded-xl border border-line bg-[#101118] text-[#e8e9f0] shadow-soft">
  <div class="flex items-center justify-between border-b border-white/10 px-4 py-2">
    <span class="font-mono text-[11px] text-white/50">{title}</span>
    <button type="button" data-copy={text} class="copy-btn rounded-md border border-white/15 px-2 py-0.5 font-mono text-[11px] text-white/70 hover:border-white/40 hover:text-white">copy</button>
  </div>
  <pre class="overflow-x-auto px-4 py-3 font-mono text-[13px] leading-relaxed"><code>{all.map((l) => (<span class="block"><span class="select-none text-[#ff8a57]">$ </span>{l}</span>))}{out && <span class="block whitespace-pre-wrap text-white/55">{out}</span>}</code></pre>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((b) => {
    if (b.dataset.bound) return;
    b.dataset.bound = '1';
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = 'copied ✓'; }
      catch { b.textContent = 'select & copy'; }
      setTimeout(() => (b.textContent = 'copy'), 1600);
    });
  });
</script>
