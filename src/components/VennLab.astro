---
/**
 * Venn lab: type two set expressions in A, B, C and see each one shaded on a Venn diagram, next to the
 * membership table. If the two shadings differ, the lab names a region (an element) that tells them apart.
 * <VennLab left="(A ∪ B)′" right="A′ ∩ B′" />
 *
 * Every region of the diagram is drawn exactly: clip to the circles the region is inside of, then mask
 * out the circles it is outside of. Regions are keyed by membership bits, e.g. "101" = in A, not B, in C.
 */
interface Props { left?: string; right?: string; id?: string; }
const { left = '(A ∪ B)′', right = 'A′ ∩ B′', id = 'venn' } = Astro.props;
const presets = [
  { label: 'De Morgan', a: '(A ∪ B)′', b: 'A′ ∩ B′', ok: true },
  { label: 'difference', a: 'A − B', b: 'A ∩ B′', ok: true },
  { label: 'distributive', a: 'A ∩ (B ∪ C)', b: '(A ∩ B) ∪ (A ∩ C)', ok: true },
  { label: 'absorption', a: 'A ∪ (A ∩ B)', b: 'A', ok: true },
  { label: 'symmetric difference', a: 'A ⊕ B', b: '(A − B) ∪ (B − A)', ok: true },
  { label: 'trap: wrong De Morgan', a: '(A ∩ B)′', b: 'A′ ∩ B′', ok: false },
  { label: 'trap: undo a difference', a: '(A − B) ∪ B', b: 'A', ok: false },
  { label: 'trap: regroup a difference', a: 'A − (B − C)', b: '(A − B) − C', ok: false },
];
const ops = [['∪', 'union'], ['∩', 'intersection'], ['−', 'difference'], ['′', 'complement'], ['⊕', 'symmetric difference'], ['(', ''], [')', ''], ['∅', 'empty set']];

// geometry: viewBox 0 0 300 220, universe rectangle with a margin
const U = { x: 6, y: 6, w: 288, h: 208 };
const layouts = {
  2: { r: 70, c: [{ n: 'A', x: 118, y: 112, lx: 66, ly: 40 }, { n: 'B', x: 182, y: 112, lx: 234, ly: 40 }] },
  3: { r: 62, c: [{ n: 'A', x: 120, y: 86, lx: 52, ly: 30 }, { n: 'B', x: 180, y: 86, lx: 248, ly: 30 }, { n: 'C', x: 150, y: 140, lx: 76, ly: 186 }] },
} as const;
const regionsOf = (k: 2 | 3) => Array.from({ length: 2 ** k }, (_, i) => i.toString(2).padStart(k, '0'));
const sides = ['x', 'y'];
---
<div class="venn card my-8 overflow-hidden shadow-soft" data-venn id={id}>
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line bg-paper-2/70 px-4 py-2.5">
    <span class="font-mono text-[11px] text-ink-3">venn lab · is X = Y for every choice of A, B, C ?</span>
    <span class="font-mono text-[11px] text-ink-3">keyboard: | &amp; - ' ^ also work</span>
  </div>

  <div class="grid gap-3 p-4 sm:grid-cols-2 sm:p-5">
    {sides.map((s, i) => (
      <label class="block min-w-0">
        <span class="eyebrow">Expression {s.toUpperCase()}</span>
        <input data-venn-in={s} type="text" spellcheck="false" autocomplete="off" autocapitalize="off" value={i === 0 ? left : right}
          class="mt-1.5 w-full rounded-lg border border-line-2 bg-paper px-3 py-2.5 font-mono text-[15px] text-ink outline-none focus:border-brand" />
      </label>
    ))}
  </div>
  <div class="flex flex-wrap gap-1.5 px-4 pb-2 sm:px-5" aria-label="Insert a symbol">
    {ops.map(([o, t]) => (
      <button type="button" data-venn-op={o} title={t} class="min-w-9 rounded-md border border-line-2 bg-card px-2 py-1 font-mono text-[14px] text-ink hover:border-brand hover:text-brand">{o}</button>
    ))}
  </div>
  <div class="flex flex-wrap gap-1.5 px-4 pb-4 sm:px-5">
    {presets.map((p) => (
      <button type="button" data-venn-a={p.a} data-venn-b={p.b} class="rounded-md border border-line px-2 py-1 font-mono text-[11px] text-ink-2 hover:border-brand hover:text-brand">
        {p.label}
      </button>
    ))}
  </div>

  <div class="grid gap-4 border-t border-line p-4 sm:grid-cols-2 sm:p-5">
    {sides.map((s) => (
      <figure class="m-0 min-w-0">
        <figcaption class="mb-1.5 truncate font-mono text-[13px] text-ink"><span class="text-ink-3">{s.toUpperCase()} =</span> <span data-venn-show={s}></span></figcaption>
        {([2, 3] as const).map((k) => {
          const L = layouts[k];
          const p = `${id}-${s}-${k}`;
          return (
            <svg viewBox="0 0 300 220" class="venn-svg w-full" data-venn-svg={s} data-k={k} hidden={k === 2 ? undefined : true} role="img" aria-label={`Venn diagram of expression ${s.toUpperCase()}`}>
              <defs>
                {L.c.map((c) => <clipPath id={`${p}-in-${c.n}`}><circle cx={c.x} cy={c.y} r={L.r} /></clipPath>)}
                {regionsOf(k).map((bits) => (
                  <mask id={`${p}-out-${bits}`} maskUnits="userSpaceOnUse" x="0" y="0" width="300" height="220">
                    <rect x={U.x} y={U.y} width={U.w} height={U.h} fill="white" />
                    {L.c.map((c, j) => bits[j] === '0' && <circle cx={c.x} cy={c.y} r={L.r} fill="black" />)}
                  </mask>
                ))}
              </defs>
              {regionsOf(k).map((bits) => {
                const ins = L.c.filter((_, j) => bits[j] === '1');
                const rect = <rect class="venn-region" data-bits={bits} x={U.x} y={U.y} width={U.w} height={U.h} mask={`url(#${p}-out-${bits})`} />;
                return ins.reduceRight((inner, c) => <g clip-path={`url(#${p}-in-${c.n})`}>{inner}</g>, rect);
              })}
              <rect x={U.x} y={U.y} width={U.w} height={U.h} rx="8" fill="none" stroke="var(--line-2)" stroke-width="1.5" />
              <text x={U.x + 9} y={U.y + 17} class="venn-label" font-size="13">U</text>
              {L.c.map((c) => <circle cx={c.x} cy={c.y} r={L.r} fill="none" stroke="var(--ink-2)" stroke-width="1.6" />)}
              {L.c.map((c) => <text x={c.lx} y={c.ly} class="venn-label" font-size="16" text-anchor="middle">{c.n}</text>)}
            </svg>
          );
        })}
      </figure>
    ))}
  </div>

  <div class="border-t border-line px-4 py-4 sm:px-5" aria-live="polite">
    <p data-venn-verdict class="font-mono text-sm font-semibold"></p>
    <p data-venn-detail class="mt-1 text-sm text-ink-2"></p>
    <details class="mt-3">
      <summary class="cursor-pointer text-sm font-semibold text-ink-2">Membership table</summary>
      <div class="mt-2 overflow-x-auto">
        <table class="venn-table font-mono text-[13px]"><thead data-venn-thead></thead><tbody data-venn-tbody></tbody></table>
      </div>
    </details>
  </div>
</div>

<style is:global>
  .venn .venn-region { fill: transparent; transition: fill 0.15s; }
  .venn .venn-region.on { fill: color-mix(in srgb, var(--brand) 38%, transparent); }
  .venn .venn-region.diff { fill: color-mix(in srgb, var(--false) 30%, transparent); }
  .venn .venn-region.on.diff { fill: color-mix(in srgb, var(--false) 55%, transparent); }
  .venn .venn-label { fill: var(--ink); font-family: var(--font-mono, ui-monospace, monospace); font-weight: 600; }
  .venn .venn-table th, .venn .venn-table td { padding: 0.2rem 0.7rem; text-align: center; border-bottom: 1px solid var(--line); }
  .venn .venn-table th { color: var(--ink-3); font-weight: 500; }
  .venn .venn-table tr.diff td { background: var(--false-soft); }
  .venn .venn-table td.one { color: var(--ink); font-weight: 700; }
  .venn .venn-table td.zero { color: var(--ink-3); }
  .prose-lesson .venn table { margin: 0; width: auto; }
</style>

<script>
  type Node =
    | { t: 'set'; n: string }
    | { t: 'not'; a: Node }
    | { t: 'bin'; op: string; a: Node; b: Node };

  const ALIASES: Record<string, string> = { '|': '∪', '+': '∪', u: '∪', '&': '∩', n: '∩', '-': '−', '\\': '−', '^': '⊕', "'": '′', '’': '′', '`': '′', '~': '¬', '!': '¬', '0': '∅' };

  function tokenize(src: string): string[] {
    const out: string[] = [];
    const s = src.replace(/\{\s*\}/g, '∅');
    for (const ch of s) {
      if (/\s/.test(ch)) continue;
      const c = ALIASES[ch] ?? ch;
      if ('ABCU∅()∪∩−⊕′¬'.includes(c)) out.push(c);
      else throw new Error(`I don't know the symbol “${ch}”. Use A, B, C, U, ∅ and ∪ ∩ − ′ ⊕.`);
    }
    return out;
  }

  // expr := term ((∪ | − | ⊕) term)* ;  term := factor (∩ factor)* ;  factor := ¬factor | atom ′*
  function parse(src: string): Node {
    const tk = tokenize(src);
    let i = 0;
    const peek = () => tk[i];
    const atom = (): Node => {
      const c = tk[i++];
      if (c === undefined) throw new Error('The expression ends too early.');
      if (c === '(') {
        const e = expr();
        if (tk[i++] !== ')') throw new Error('A “(” is never closed.');
        return e;
      }
      if ('ABCU∅'.includes(c)) return { t: 'set', n: c };
      throw new Error(`Expected a set or “(”, found “${c}”.`);
    };
    const factor = (): Node => {
      if (peek() === '¬') { i++; return { t: 'not', a: factor() }; }
      let a = atom();
      while (peek() === '′') { i++; a = { t: 'not', a }; }
      return a;
    };
    const term = (): Node => {
      let a = factor();
      while (peek() === '∩') { i++; a = { t: 'bin', op: '∩', a, b: factor() }; }
      return a;
    };
    const expr = (): Node => {
      let a = term();
      while (peek() === '∪' || peek() === '−' || peek() === '⊕') { const op = tk[i++]; a = { t: 'bin', op, a, b: term() }; }
      return a;
    };
    if (!tk.length) throw new Error('Type an expression, for example A ∪ B.');
    const e = expr();
    if (i < tk.length) throw new Error(`Unexpected “${tk[i]}”. Is an operator missing?`);
    return e;
  }

  const ev = (e: Node, m: Record<string, boolean>): boolean => {
    if (e.t === 'set') return e.n === 'U' ? true : e.n === '∅' ? false : m[e.n];
    if (e.t === 'not') return !ev(e.a, m);
    const a = ev(e.a, m), b = ev(e.b, m);
    return e.op === '∪' ? a || b : e.op === '∩' ? a && b : e.op === '−' ? a && !b : a !== b;
  };
  const sets = (e: Node, acc = new Set<string>()): Set<string> => {
    if (e.t === 'set') { if ('ABC'.includes(e.n)) acc.add(e.n); }
    else if (e.t === 'not') sets(e.a, acc);
    else { sets(e.a, acc); sets(e.b, acc); }
    return acc;
  };
  const prec = (e: Node) => (e.t === 'bin' ? (e.op === '∩' ? 2 : 1) : 3);
  const show = (e: Node): string => {
    if (e.t === 'set') return e.n;
    if (e.t === 'not') return e.a.t === 'set' ? `${e.a.n}′` : `(${show(e.a)})′`;
    // ∪, − and ⊕ share a level; mixing them without brackets is legal but hard to read, so show the brackets
    const mixed = e.a.t === 'bin' && prec(e.a) === 1 && prec(e) === 1 && e.a.op !== e.op;
    const l = prec(e.a) < prec(e) || mixed ? `(${show(e.a)})` : show(e.a);
    const r = prec(e.b) <= prec(e) && !(e.op === '∩' && prec(e.b) === 2) ? `(${show(e.b)})` : show(e.b);
    return `${l} ${e.op} ${r}`;
  };

  document.querySelectorAll<HTMLElement>('[data-venn]').forEach((root) => {
    const inputs = { x: root.querySelector<HTMLInputElement>('[data-venn-in="x"]')!, y: root.querySelector<HTMLInputElement>('[data-venn-in="y"]')! };
    const verdict = root.querySelector<HTMLElement>('[data-venn-verdict]')!;
    const detail = root.querySelector<HTMLElement>('[data-venn-detail]')!;
    const thead = root.querySelector<HTMLElement>('[data-venn-thead]')!;
    const tbody = root.querySelector<HTMLElement>('[data-venn-tbody]')!;
    let focused: HTMLInputElement = inputs.x;

    const fail = (side: string, msg: string) => {
      verdict.className = 'font-mono text-sm font-semibold text-accent';
      verdict.textContent = `Expression ${side.toUpperCase()}: ${msg}`;
      detail.textContent = '';
    };

    const run = () => {
      const ast: Record<string, Node> = {};
      for (const s of ['x', 'y'] as const) {
        try { ast[s] = parse(inputs[s].value); } catch (e) { fail(s, (e as Error).message); return; }
      }
      const used = new Set([...sets(ast.x), ...sets(ast.y)]);
      const k = used.has('C') ? 3 : 2;
      const names = ['A', 'B', 'C'].slice(0, k);
      // membership-table order: 11…1 first, as in Rosen
      const rows = Array.from({ length: 2 ** k }, (_, i) => (2 ** k - 1 - i).toString(2).padStart(k, '0'));
      const val = (s: 'x' | 'y', bits: string) => ev(ast[s], Object.fromEntries(names.map((n, j) => [n, bits[j] === '1'])));
      const diff = new Set(rows.filter((b) => val('x', b) !== val('y', b)));

      for (const s of ['x', 'y'] as const) {
        root.querySelector<HTMLElement>(`[data-venn-show="${s}"]`)!.textContent = show(ast[s]);
        root.querySelectorAll<SVGSVGElement>(`[data-venn-svg="${s}"]`).forEach((svg) => {
          const on = svg.dataset.k === String(k);
          svg.toggleAttribute('hidden', !on);
          if (!on) return;
          svg.querySelectorAll<SVGRectElement>('.venn-region').forEach((r) => {
            const b = r.dataset.bits!;
            r.classList.toggle('on', val(s, b));
            r.classList.toggle('diff', diff.has(b));
          });
        });
      }

      thead.innerHTML = `<tr>${names.map((n) => `<th>${n}</th>`).join('')}<th>X</th><th>Y</th></tr>`;
      const cell = (v: boolean) => `<td class="${v ? 'one' : 'zero'}">${v ? 1 : 0}</td>`;
      tbody.innerHTML = rows.map((b) => `<tr class="${diff.has(b) ? 'diff' : ''}">${[...b].map((c) => cell(c === '1')).join('')}${cell(val('x', b))}${cell(val('y', b))}</tr>`).join('');

      if (!diff.size) {
        verdict.className = 'font-mono text-sm font-semibold text-true';
        verdict.textContent = `✓ equal: the same ${rows.length === 4 ? 'four' : 'eight'} regions are shaded`;
        detail.textContent = `X and Y agree on every row of the membership table, so X = Y is an identity: it holds for every choice of ${names.join(', ')}.`;
      } else {
        const b = [...diff][0];
        const where = names.map((n, j) => `x ${b[j] === '1' ? '∈' : '∉'} ${n}`).join(', ');
        verdict.className = 'font-mono text-sm font-semibold text-false';
        verdict.textContent = `✗ not equal: they differ in ${diff.size} region${diff.size > 1 ? 's' : ''} (shown in red)`;
        detail.textContent = `Counterexample: an element with ${where} is ${val('x', b) ? 'in' : 'not in'} X but ${val('y', b) ? 'in' : 'not in'} Y.`;
      }
    };

    for (const inp of Object.values(inputs)) {
      inp.addEventListener('input', run);
      inp.addEventListener('focus', () => (focused = inp));
    }
    root.querySelectorAll<HTMLButtonElement>('[data-venn-op]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const o = btn.dataset.vennOp!;
        const s = focused.selectionStart ?? focused.value.length, e = focused.selectionEnd ?? s;
        const ins = '∪∩−⊕'.includes(o) ? ` ${o} ` : o;
        focused.value = focused.value.slice(0, s) + ins + focused.value.slice(e);
        focused.focus();
        focused.setSelectionRange(s + ins.length, s + ins.length);
        run();
      }));
    root.querySelectorAll<HTMLButtonElement>('[data-venn-a]').forEach((btn) =>
      btn.addEventListener('click', () => { inputs.x.value = btn.dataset.vennA!; inputs.y.value = btn.dataset.vennB!; run(); }));
    run();
  });
</script>
