---
/**
 * Sets as boxes: ∅ is an empty box, {∅} is a box with an empty box inside, and so on.
 * A box counts the things directly inside it, not what is inside those things.
 */
type Item = { box: Item[] } | { label: string };
const sets: { name: string; size: number; items: Item[] }[] = [
  { name: '∅ = { }', size: 0, items: [] },
  { name: '{∅}', size: 1, items: [{ box: [] }] },
  { name: '{∅, {∅}}', size: 2, items: [{ box: [] }, { box: [{ box: [] }] }] },
  { name: '{1, {1}}', size: 2, items: [{ label: '1' }, { box: [{ label: '1' }] }] },
];
---
<figure class="setboxes not-prose my-8">
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    {sets.map((s) => (
      <div class="min-w-0 text-center">
        <div class="sb-box sb-outer mx-auto">
          {s.items.map((it) => 'label' in it
            ? <span class="sb-el">{it.label}</span>
            : <span class="sb-box sb-inner">{it.box.map((j) => 'label' in j ? <span class="sb-el">{j.label}</span> : <span class="sb-box sb-tiny"></span>)}</span>)}
        </div>
        <p class="mt-2 font-mono text-[14px] font-semibold text-ink">{s.name}</p>
        <p class="font-mono text-[11.5px] text-ink-3">{s.size} element{s.size === 1 ? '' : 's'}</p>
      </div>
    ))}
  </div>
  <figcaption class="mt-3 text-center text-[13px] text-ink-3">A set is a box. Its elements are the things directly inside it; a box inside a box counts as one thing.</figcaption>
</figure>

<style>
  .sb-box { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; border: 2px solid var(--ink-2); border-radius: 0.5rem; background: var(--card); }
  .sb-outer { display: flex; width: 100%; max-width: 9.5rem; height: 5.5rem; border-color: var(--mod-teal); background: color-mix(in srgb, var(--mod-teal) 7%, var(--card)); }
  .sb-inner { min-width: 2.3rem; height: 2.3rem; padding: 0 0.35rem; }
  .sb-tiny { width: 1rem; height: 1rem; border-width: 1.5px; border-radius: 0.25rem; }
  .sb-el { font-family: ui-monospace, monospace; font-weight: 700; font-size: 15px; color: var(--ink); }
</style>
