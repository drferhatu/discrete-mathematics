---
import { course, href } from '@/lib/site';
import { getCollection } from 'astro:content';

// newest announcement date, used on the client to show a "new" dot for 7 days
const latest = (await getCollection('announcements')).map((a) => a.data.date.toISOString().slice(0, 10)).sort().at(-1) ?? '';

const nav = [
  { label: 'Syllabus', path: '/syllabus' },
  { label: 'Schedule', path: '/schedule' },
  { label: 'Weeks', path: '/weeks' },
  { label: 'Labs', path: '/labs' },
  { label: 'Project', path: '/project' },
  { label: 'Resources', path: '/resources' },
  { label: 'Announcements', path: '/announcements' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (p: string) => current === href(p).replace(/\/$/, '') || current.startsWith(href(p) + '/');
---
<header data-latest-news={latest} class="sticky top-0 z-50 border-b border-line/80 bg-paper/80 backdrop-blur-md">
  <div id="reading-progress" class="absolute inset-x-0 top-0 h-[2px] bg-accent" aria-hidden="true"></div>
  <div class="wrap flex h-15 items-center justify-between gap-4 py-3">
    <a href={href('/')} class="group flex items-center gap-3 text-ink">
      <span class="grid size-9 place-items-center rounded-lg bg-ink font-mono text-[15px] font-semibold text-paper transition-colors group-hover:bg-brand" aria-hidden="true">∀</span>
      <span class="leading-tight">
        <span class="block font-display text-xl">{course.title}</span>
        <span class="block whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.14em] text-ink-3">{course.code} · Fall 2026<span class="hidden xl:inline"> · {course.instructor.name}</span></span>
        <span class="block whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.14em] text-ink-3 xl:hidden">{course.instructor.name}</span>
      </span>
    </a>

    <nav aria-label="Main" class="hidden lg:flex items-center gap-0.5">
      {nav.map((n) => (
        <a
          href={href(n.path)}
          aria-current={isActive(n.path) ? 'page' : undefined}
          class:list={[
            'relative rounded-lg px-2.5 py-2 text-sm font-medium transition-colors',
            isActive(n.path) ? 'bg-ink text-paper' : 'text-ink-2 hover:bg-paper-2 hover:text-ink',
          ]}
        >{n.label}{n.path === '/announcements' && <span class="news-dot absolute right-0.5 top-1 hidden size-2 rounded-full bg-accent ring-2 ring-paper" aria-hidden="true"></span>}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={href('/search')} class="grid size-9 place-items-center rounded-lg border border-line-2 text-ink-2 hover:border-ink hover:text-ink" aria-label="Search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <button id="theme-toggle" type="button" class="grid size-9 place-items-center rounded-lg border border-line-2 text-ink-2 hover:border-ink hover:text-ink" aria-label="Toggle dark mode">
        <svg class="theme-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
      <button id="nav-toggle" class="lg:hidden grid size-9 place-items-center rounded-lg border border-line-2 text-ink" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <svg class="icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="icon-close hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" class="hidden lg:hidden border-t border-line bg-paper">
    <div class="wrap flex flex-col py-3">
      {nav.map((n) => (
        <a href={href(n.path)} aria-current={isActive(n.path) ? 'page' : undefined}
           class:list={['rounded-lg px-3 py-3 text-base font-medium', isActive(n.path) ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2']}>{n.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  :global([data-theme='dark']) .theme-sun { display: none; }
  :global([data-theme='light']) .theme-moon { display: none; }
</style>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = menu!.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    btn.querySelector('.icon-open')?.classList.toggle('hidden', open);
    btn.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  });

  // "new" dot on Announcements when the newest one is less than 7 days old
  const latest = document.querySelector<HTMLElement>('[data-latest-news]')?.dataset.latestNews;
  if (latest && Date.now() - new Date(latest + 'T00:00:00').getTime() < 7 * 864e5) {
    document.querySelectorAll('.news-dot').forEach((d) => d.classList.remove('hidden'));
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });

  // reading progress on pages that opt in with data-reading-progress
  const bar = document.getElementById('reading-progress');
  const article = document.querySelector<HTMLElement>('[data-reading-progress]');
  if (bar && article) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
  }
</script>
