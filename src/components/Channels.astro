---
/**
 * Contact channels (WhatsApp, Instagram, calendar, office hours) with QR codes,
 * so they can also be scanned from the classroom projector.
 * Data: content/data/course.json → channels. QR codes: scripts/make_qr.py → public/qr/<id>.svg
 */
import { course, href } from '@/lib/site';
interface Props { compact?: boolean; title?: string; lede?: string; }
const {
  compact = false,
  title = 'Stay in the loop',
  lede = 'Scan a code with your phone or click the button. Please join the WhatsApp channel: announcements land there first.',
} = Astro.props;
const ICON: Record<string, string> = {
  whatsapp: 'M20 12a8 8 0 0 1-11.6 7.1L4 20l.9-4.2A8 8 0 1 1 20 12z M9 9.5c.3 2.5 2.7 4.9 5.2 5.2l1.3-1.3-1.8-.9-.9.9a4.6 4.6 0 0 1-2.5-2.5l.9-.9-.9-1.8z',
  instagram: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z M17.5 6.5h.01',
  calendar: 'M4 6h16v14H4z M4 10h16 M8 3v4 M16 3v4',
  office: 'M12 7v5l3 2 M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z',
};
const ACCENT: Record<string, string> = { whatsapp: 'var(--true)', instagram: 'var(--mod-rose)', calendar: 'var(--brand)', office: 'var(--accent)' };
---
<section aria-labelledby="channels" class:list={[compact ? '' : 'card p-6 shadow-soft sm:p-8']}>
  <div class="mb-6">
    <p class="eyebrow">Contact &amp; channels</p>
    <h2 id="channels" class="display mt-1 text-3xl text-ink md:text-4xl">{title}</h2>
    {!compact && <p class="mt-2 max-w-2xl text-[15px] text-ink-2">{lede}</p>}
  </div>
  <ul class:list={['grid gap-4', compact ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4']}>
    {course.channels.map((c) => (
      <li class="flex flex-col rounded-xl border border-line bg-card p-4" style={`--c:${ACCENT[c.id] ?? 'var(--brand)'}`}>
        <div class="flex items-center gap-2.5">
          <span class="grid size-9 shrink-0 place-items-center rounded-lg text-[var(--c)]" style="background: color-mix(in srgb, var(--c) 13%, transparent)" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={ICON[c.id]} /></svg>
          </span>
          <h3 class="text-sm font-semibold leading-snug text-ink">{c.name}</h3>
        </div>
        <p class="mt-2 text-[13px] leading-relaxed text-ink-2">{c.desc}</p>
        {!compact && <img src={href(`/qr/${c.id}.svg`)} alt={`QR code: ${c.name}`} width="144" height="144" class="mx-auto mt-4 size-36 rounded-lg border border-line bg-white p-2" loading="lazy" />}
        <div class="mt-auto pt-4">
          <a href={c.url} target="_blank" rel="noopener" class="btn-primary w-full justify-center !py-2 !text-xs">
            {c.cta} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </li>
    ))}
  </ul>
</section>
