---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Channels from '@/components/Channels.astro';
import { getCollection, render } from 'astro:content';
import { formatDateObj } from '@/lib/site';
// newest first; announcements from the same day keep the order of their file names (newest last → first)
const items = (await getCollection('announcements')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id));
const rendered = await Promise.all(items.map(async (a) => ({ a, C: (await render(a)).Content })));
const KIND: Record<string, string> = { info: 'bg-paper-2 text-ink-2', important: 'bg-accent-soft text-accent', exam: 'bg-false-soft text-false', lab: 'bg-brand-soft text-brand' };
---
<BaseLayout title="Announcements" description="Course announcements for Discrete Mathematics.">
  <div class="wrap-narrow pt-14 md:pt-20">
    <SectionHeading eyebrow="Announcements" title="What's new" lede="Newest first. Urgent notices also go to the WhatsApp channel." />
    <ol class="mt-10 space-y-5">
      {rendered.map(({ a, C }, i) => (
        <li id={a.id} class:list={['card scroll-mt-24 p-6', i === 0 && 'border-line-2 shadow-soft']}>
          <div class="flex flex-wrap items-center gap-2">
            <span class:list={['rounded-md px-2 py-0.5 font-mono text-[11px] font-semibold uppercase', KIND[a.data.kind]]}>{a.data.kind}</span>
            <span class="font-mono text-xs text-ink-3">{formatDateObj(a.data.date)}</span>
            {i === 0 && <span class="rounded-md bg-accent px-2 py-0.5 font-mono text-[11px] font-semibold uppercase text-white">latest</span>}
            {a.data.pinned && i !== 0 && <span class="font-mono text-xs text-accent">pinned</span>}
          </div>
          <h2 class="mt-3 text-xl font-semibold text-ink">{a.data.title}</h2>
          <div class="prose-lesson mt-3 !text-base"><C /></div>
        </li>
      ))}
    </ol>
  </div>
  <div class="wrap pb-6 pt-16"><Channels title="Never miss an announcement" /></div>
</BaseLayout>
