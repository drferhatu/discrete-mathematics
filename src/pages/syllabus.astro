---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Channels from '@/components/Channels.astro';
import { course, href, weekHref } from '@/lib/site';
const a = course.assessment;
---
<BaseLayout title="Syllabus" description="Course description, learning outcomes, grading and policies for Discrete Mathematics (YMT211).">
  <header class="border-b border-line">
    <div class="wrap grid gap-10 py-14 md:grid-cols-[1.3fr_1fr] md:py-20">
      <div>
        <p class="eyebrow">Syllabus · {course.code}</p>
        <h1 class="display mt-3 text-5xl leading-[1] text-ink md:text-7xl">About the course</h1>
        <p class="lede mt-6">{course.description}</p>
      </div>
      <dl class="card grid h-fit gap-4 p-6 text-sm">
        {[
          ['Instructor', course.instructor.name],
          ['Email', course.instructor.email],
          ['Class', `${course.meeting.day} ${course.meeting.time}`],
          ['Room', course.meeting.room],
          ['Format', course.meeting.format],
          ['Program', course.program],
          ['Language', course.language],
          ['Prerequisites', 'None beyond high-school algebra. No prior programming is assumed for the math; basic Python helps in the labs.'],
        ].map(([k, v]) => (
          <div class="grid grid-cols-[7.5rem_1fr] gap-3 border-b border-line pb-3 last:border-0 last:pb-0">
            <dt class="eyebrow pt-0.5">{k}</dt>
            <dd class="text-ink">{k === 'Email' ? <a class="link" href={`mailto:${v}`}>{v}</a> : v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </header>

  <section class="wrap pt-16"><Channels title="Reach me" lede="Join the WhatsApp channel for announcements, check my calendar before you drop by, and book an office-hours slot for questions or your project." /></section>

  <section class="wrap py-16">
    <SectionHeading eyebrow="Philosophy" title="A language for precise thinking" lede={course.philosophy.intro} />
    <ul class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {course.philosophy.points.map((p, i) => (
        <li>
          <p class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-1 font-semibold text-ink">{p.t}</h3>
          <p class="mt-1 text-[15px] leading-relaxed text-ink-2">{p.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-y border-line bg-paper-2/50">
    <div class="wrap py-16">
      <SectionHeading eyebrow="Learning outcomes" title="What you will be able to do" />
      <ol class="mt-10 grid gap-3 md:grid-cols-2">
        {course.outcomes.map((o) => (
          <li class="card flex gap-4 p-5">
            <span class="font-mono text-sm font-semibold text-brand">{o.id}</span>
            <div>
              <p class="text-ink">{o.text}</p>
              <p class="mt-2 flex flex-wrap gap-1.5">
                {o.weeks.map((w) => <a href={weekHref(w)} class="rounded bg-paper-2 px-1.5 py-0.5 font-mono text-[11px] text-ink-2 hover:bg-brand-soft hover:text-brand">W{w}</a>)}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap grid gap-12 py-16 md:grid-cols-2">
    <div>
      <SectionHeading eyebrow="Grading" title="How your grade is built" />
      <div class="mt-8 space-y-4">
        {a.components.map((c) => (
          <div class="card p-5">
            <div class="flex items-baseline justify-between"><p class="font-semibold text-ink">{c.name}</p><p class="display text-4xl text-ink">{c.weight}%</p></div>
            <p class="mt-1 text-sm text-ink-2">{c.note}</p>
          </div>
        ))}
        <div class="card p-5">
          <p class="eyebrow">Inside the final (60%)</p>
          <div class="mt-3 flex h-3 overflow-hidden rounded-full bg-paper-2">
            <span class="bg-accent" style="width:85%"></span><span class="bg-true" style="width:15%"></span>
          </div>
          <div class="mt-2 flex justify-between text-xs text-ink-2">
            {a.finalSplit.map((f) => <span>{f.name} {f.weight}%</span>)}
          </div>
          <p class="mt-3 text-sm text-ink-2">The project therefore counts for 9% of your overall course grade. <a class="link" href={href('/project')}>Project details →</a></p>
        </div>
        <p class="text-sm text-ink-2">{a.labsNote} <a class="link" href={href('/labs')}>How labs work →</a></p>
      </div>
    </div>
    <div>
      <SectionHeading eyebrow="Policies" title="The fine print" />
      <dl class="mt-8 space-y-5">
        {course.policies.map((p) => (
          <div class="border-l-2 border-line-2 pl-4">
            <dt class="font-semibold text-ink">{p.t}</dt>
            <dd class="mt-1 text-[15px] leading-relaxed text-ink-2">{p.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
