---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Toc from '@/components/Toc.astro';
import Terminal from '@/components/Terminal.astro';
import Step from '@/components/Step.astro';
import { getCollection, render } from 'astro:content';
import { href } from '@/lib/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
---
<BaseLayout title={guide.data.title} description={guide.data.description} ogType="article">
  <header class="border-b border-line">
    <div class="wrap py-12 md:py-16">
      <nav aria-label="Breadcrumb" class="font-mono text-xs text-ink-3"><a href={href('/resources')} class="hover:text-ink">resources</a> / guides</nav>
      <h1 class="display mt-4 max-w-3xl text-4xl sm:text-5xl md:text-6xl">{guide.data.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-2">{guide.data.description}</p>
    </div>
  </header>
  <div class="wrap grid grid-cols-1 gap-12 py-12 lg:grid-cols-[1fr_230px]">
    <article class="prose-lesson min-w-0 max-w-3xl" data-reading-progress><Content components={{ Terminal, Step }} /></article>
    <aside class="hidden lg:block"><div class="sticky top-24"><Toc headings={headings} /></div></aside>
  </div>
</BaseLayout>
